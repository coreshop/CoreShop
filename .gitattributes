# Packaged Studio builds — one archive per bundle, named after the source-derived build id, so
# the file name changes with the sources and is matched with a glob. Collapse the diff view,
# treat as binary and take the current side wholesale on merges instead of conflicting: the
# next build on the merged branch produces the right archive anyway.
src/CoreShop/Bundle/*/Resources/build-dist/build-*.zip linguist-generated=true
src/CoreShop/Bundle/*/Resources/build-dist/build-*.zip binary
src/CoreShop/Bundle/*/Resources/build-dist/build-*.zip merge=ours
