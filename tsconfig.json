{
  "compilerOptions": {
    "rootDir": ".",
    "module": "ESNext",
    "target": "ES2023",
    "moduleResolution": "Node",
    "baseUrl": "./js/",
    "strictNullChecks": true,
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/build/types",
    "composite": true
  },

  "include": [
    "./assets/js/**/*"
  ],
}
