{
  "compilerOptions": {
    "rootDir": ".",
    "module": "ESNext",
    "target": "ES2023",
    "moduleResolution": "bundler",
    "baseUrl": "./js/",
    "strictNullChecks": true,
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/build/types",
    "composite": true,
    "types": ["reflect-metadata", "@types/webpack-env" ],
    "paths": {
      "@Pimcore/*": [
        "./node_modules/pimcore-studio-ui/dist/build/types/src/*"
      ]
    }
  },

  "include": [
    "./assets/js/**/*"
  ],
}
