{
    "name": "coreshop/studio-form-bundle",
    "type": "pimcore-bundle",
    "description": "CoreShop - Studio Form Bundle",
    "keywords": [
        "coreshop",
        "pimcore",
        "studio",
        "form",
        "schema"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/form": "^6.3 || ^7.0",
        "symfony/http-kernel": "^6.3 || ^7.0",
        "symfony/framework-bundle": "^6.3 || ^7.0",
        "symfony/serializer": "^6.3 || ^7.0",
        "pimcore/pimcore": "^12.0",
        "pimcore/studio-ui-bundle": "^0.6.30"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Bundle\\StudioFormBundle\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "5.0-dev",
            "dev-master": "5.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
