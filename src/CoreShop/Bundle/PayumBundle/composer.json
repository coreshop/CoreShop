{
    "name": "coreshop/payum-bundle",
    "type": "pimcore-bundle",
    "description": "CoreShop - Payment Bundle",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/order-bundle": "^5.0",
        "coreshop/payment-bundle": "^5.0",
        "coreshop/payum-payment-bundle": "^5.0",
        "coreshop/core": "^5.0",
        "payum/payum-bundle": "^2.6.2",
        "payum/payum": "^1.7",
        "php-http/message-factory": "^1.0",
        "symfony/notifier": "^6.4.14 || ^7.2",
        "symfony/serializer": "^6.4.14 || ^7.2",
        "php-http/guzzle7-adapter": "^1.0",
        "pimcore/pimcore": "^12.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Bundle\\PayumBundle\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "5.0-dev",
            "dev-master": "5.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
