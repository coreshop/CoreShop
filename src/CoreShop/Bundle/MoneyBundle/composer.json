{
  "name": "coreshop/money-bundle",
  "type": "pimcore-bundle",
  "description": "CoreShop - Money Bundle",
  "keywords": [
    "coreshop",
    "pimcore",
    "ecommerce"
  ],
  "homepage": "https://www.coreshop.com",
  "license": "proprietary",
  "authors": [
    {
      "name": "CoreShop Team",
      "email": "info@coreshop.com",
      "homepage": "https://www.coreshop.com/",
      "role": "Developer"
    },
    {
      "name": "Dominik Pfaffenbauer",
      "email": "dominik@pfaffenbauer.at",
      "homepage": "https://www.pfaffenbauer.at/",
      "role": "Developer"
    }
  ],
  "require": {
    "coreshop/currency": "^5.0",
    "coreshop/pimcore-bundle": "^5.0",
    "symfony/form": "^6.3 || ^7.0",
    "pimcore/pimcore": "^12.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-webmozart-assert": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "CoreShop\\Bundle\\MoneyBundle\\": ""
    }
  },
  "repositories": [
      {
          "type": "path",
          "url": "../../*/*"
      }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "5.0-dev",
      "dev-master": "5.0-dev"
    }
  },
  "config": {
    "sort-packages": true
  }
}
