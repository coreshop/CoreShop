{
    "name": "coreshop/pimcore-bundle",
    "type": "pimcore-bundle",
    "description": "CoreShop - Pimcore Extension Bundle",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/pimcore": "^2026.1",
        "coreshop/registry": "^2026.1",
        "pimcore/pimcore": "^2026.1"
    },
    "require-dev": {
        "pimcore/studio-ui-bundle": "^2026.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "suggest": {
        "pimcore/elasticsearch-client": "Allows to use ElasticSearch as your index engine.",
        "pimcore/opensearch-client": "Allows to use OpenSearch as your index engine."
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Bundle\\PimcoreBundle\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2026.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
