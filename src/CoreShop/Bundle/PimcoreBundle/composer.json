{
  "name": "coreshop/pimcore-bundle",
  "type": "pimcore-bundle",
  "description": "CoreShop - Pimcore Extension Bundle",
  "keywords": [
    "coreshop",
    "pimcore",
    "ecommerce"
  ],
  "homepage": "https://www.coreshop.com",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "CoreShop Team",
      "email": "info@coreshop.com",
      "homepage": "https://www.coreshop.com/",
      "role": "Developer"
    },
    {
      "name": "Dominik Pfaffenbauer",
      "email": "dominik@pfaffenbauer.at",
      "homepage": "https://www.pfaffenbauer.at/",
      "role": "Developer"
    }
  ],
  "require": {
    "coreshop/pimcore": "^5.0",
    "coreshop/registry": "^5.0",
    "pimcore/pimcore": "^12.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-doctrine": "^1.3.40",
    "phpstan/phpstan-webmozart-assert": "^1.2.4"
  },
  "suggested": {
    "pimcore/admin-ui-classic-bundle": "If you wanna use the Classic Admin UI",
    "pimcore/studio-backend-bundle": "If you wanna use the Studio Backend",
    "pimcore/studio-ui-bundle": "If you wanna use the Studio UI"
  },
  "autoload": {
    "psr-4": {
      "CoreShop\\Bundle\\PimcoreBundle\\": ""
    }
  },
  "repositories": [
      {
          "type": "path",
          "url": "../../*/*"
      }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "5.0-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
