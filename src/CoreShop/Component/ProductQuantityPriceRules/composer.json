{
    "name": "coreshop/product-quantity-price-rules",
    "type": "library",
    "description": "CoreShop Product Quantity Price Rules Component.",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "Stefan Hagspiel",
            "email": "shagspiel@dachcom.com",
            "homepage": "https://www.dachcom.com/",
            "role": "Developer"
        },
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/resource": "^2026.1",
        "coreshop/registry": "^2026.1",
        "coreshop/rule": "^2026.1",
        "pimcore/pimcore": "^2026.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
