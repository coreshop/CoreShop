{
  "name": "coreshop/pimcore",
  "type": "library",
  "description": "CoreShop Pimcore Utilities Component.",
  "keywords": [
    "coreshop",
    "pimcore",
    "ecommerce"
  ],
  "homepage": "https://www.coreshop.com",
  "license": "proprietary",
  "authors": [
    {
      "name": "CoreShop Team",
      "email": "info@coreshop.com",
      "homepage": "https://www.coreshop.com/",
      "role": "Developer"
    },
    {
      "name": "Dominik Pfaffenbauer",
      "email": "dominik@pfaffenbauer.at",
      "homepage": "https://www.pfaffenbauer.at/",
      "role": "Developer"
    }
  ],
  "require": {
    "pimcore/pimcore": "^12.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-doctrine": "^1.3.40",
    "phpstan/phpstan-webmozart-assert": "^1.2.4"
  },
  "suggest": {
    "pimcore/admin-ui-classic-bundle": "If you wanna use the Classic Admin UI"
  },
  "autoload": {
    "psr-4": {
      "CoreShop\\Component\\Pimcore\\": ""
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../*/*"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "5.0-dev",
      "dev-master": "5.0-dev"
    }
  },
  "config": {
    "sort-packages": true
  }
}
