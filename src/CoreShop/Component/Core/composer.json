{
    "name": "coreshop/core",
    "type": "library",
    "description": "CoreShop Core Component (Glue)",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/configuration": "^5.0",
        "coreshop/store": "^5.0",
        "coreshop/resource": "^5.0",
        "coreshop/address": "^5.0",
        "coreshop/order": "^5.0",
        "coreshop/currency": "^5.0",
        "coreshop/customer": "^5.0",
        "coreshop/shipping": "^5.0",
        "coreshop/inventory": "^5.0",
        "coreshop/product": "^5.0",
        "coreshop/product-quantity-price-rules": "^5.0",
        "coreshop/index": "^5.0",
        "coreshop/payment": "^5.0",
        "coreshop/payum-payment": "^5.0",
        "coreshop/taxation": "^5.0",
        "coreshop/notification": "^5.0",
        "coreshop/payum-bundle": "^5.0",
        "coreshop/variant": "^5.0",
        "coreshop/seo": "^5.0",
        "coreshop/user": "^5.0",
        "coreshop/tracking": "^5.0",
        "coreshop/wishlist": "^5.0",
        "pimcore/pimcore": "^12.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Component\\Core\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "5.0-dev",
            "dev-master": "5.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
