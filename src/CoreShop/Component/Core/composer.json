{
    "name": "coreshop/core",
    "type": "library",
    "description": "CoreShop Core Component (Glue)",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/configuration": "^2026.1",
        "coreshop/store": "^2026.1",
        "coreshop/resource": "^2026.1",
        "coreshop/address": "^2026.1",
        "coreshop/order": "^2026.1",
        "coreshop/currency": "^2026.1",
        "coreshop/customer": "^2026.1",
        "coreshop/shipping": "^2026.1",
        "coreshop/inventory": "^2026.1",
        "coreshop/product": "^2026.1",
        "coreshop/product-quantity-price-rules": "^2026.1",
        "coreshop/index": "^2026.1",
        "coreshop/payment": "^2026.1",
        "coreshop/payum-payment": "^2026.1",
        "coreshop/taxation": "^2026.1",
        "coreshop/notification": "^2026.1",
        "coreshop/payum-bundle": "^2026.1",
        "coreshop/variant": "^2026.1",
        "coreshop/seo": "^2026.1",
        "coreshop/user": "^2026.1",
        "coreshop/tracking": "^2026.1",
        "coreshop/wishlist": "^2026.1",
        "pimcore/pimcore": "^2026.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Component\\Core\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2026.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
