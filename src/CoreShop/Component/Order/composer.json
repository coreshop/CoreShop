{
    "name": "coreshop/order",
    "type": "library",
    "description": "CoreShop Order Component.",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/address": "^5.1",
        "coreshop/rule": "^5.1",
        "coreshop/registry": "^5.1",
        "coreshop/resource": "^5.1",
        "coreshop/sequence": "^5.1",
        "coreshop/store": "^5.1",
        "coreshop/currency": "^5.1",
        "coreshop/taxation": "^5.1",
        "coreshop/payment": "^5.1",
        "coreshop/pimcore": "^5.1",
        "coreshop/customer": "^5.1",
        "coreshop/storage-list": "^5.1",
        "coreshop/workflow-bundle": "^5.1",
        "pimcore/pimcore": "^12.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Component\\Order\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "5.1-dev",
            "dev-master": "5.1-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
